---
import BaseLayout from '../../layouts/BaseLayout.astro';

const slides = [
  { src: '/images/wegatherevents-1.png', alt: 'WeGatherEvents vendor portal sign-in screen', caption: 'Secure vendor onboarding and workspace access.' },
  { src: '/images/wegatherevents-2.png', alt: 'WeGatherEvents operations dashboard showing event and guest metrics', caption: 'A live operations dashboard for events, guests, cards, delivery, and arrivals.' },
  { src: '/images/wegatherevents-3.png', alt: 'WeGatherEvents access-card designer with draggable guest data regions', caption: 'Visual access-card composition with configurable guest details and QR codes.' },
  { src: '/images/wegatherevents-4.png', alt: 'WeGatherEvents check-in booth event code screen', caption: 'A reusable check-in booth connects securely to an event using a private code.' },
  { src: '/images/wegatherevents-6.png', alt: 'WeGatherEvents guest pass displayed after check-in', caption: 'A personalized guest pass completes the live check-in flow.' },
];
---

<BaseLayout
  title="WeGatherEvents: Kennedy Ekanem"
  description="An event management platform for vendor onboarding, registration, communication, access cards, and live check-in."
>
  <article class="project-page">
    <a class="back-link" href="/#work">← Back to work</a>

    <header class="project-header">
      <p class="project-meta">Product Engineering · Event operations</p>
      <h1>WeGatherEvents</h1>
      <p class="project-intro">
        An event management platform for vendor onboarding, attendee registration,
        guest communication, access-card generation, and live check-in.
      </p>
    </header>

    <section class="project-slideshow" aria-label="WeGatherEvents interface gallery" data-slideshow tabindex="0">
      <div class="slides" aria-live="polite">
        {slides.map((slide, index) => (
          <figure class="slide" data-slide hidden={index !== 0}>
            <img src={slide.src} alt={slide.alt} />
            <figcaption>{slide.caption}</figcaption>
          </figure>
        ))}
      </div>
      <div class="slideshow-controls">
        <button type="button" data-previous aria-label="Show previous image">← Previous</button>
        <p><span data-current>1</span> / {slides.length}</p>
        <button type="button" data-next aria-label="Show next image">Next →</button>
      </div>
      <div class="slide-dots" aria-label="Choose an image">
        {slides.map((_, index) => <button type="button" data-dot={index} class:list={{ active: index === 0 }} aria-label={`Show image ${index + 1}`} aria-current={index === 0 ? 'true' : undefined}></button>)}
      </div>
    </section>

    <section class="project-copy">
      <h2>Overview</h2>
      <p>
        WeGatherEvents brings the operational parts of an event into one connected
        workspace. Vendors can onboard, publish registration experiences, manage guests,
        communicate with attendees, design access cards, and run check-in without moving
        between disconnected tools.
      </p>
      <p>
        The platform connects the planning workflow to the live event experience, giving
        teams a consistent source of truth from registration through arrival.
      </p>

      <h2>Platform capabilities</h2>
      <ul>
        <li>Secure vendor onboarding and event-scoped workspaces.</li>
        <li>Attendee registration and centralized guest management.</li>
        <li>Personalized guest communication using HTML email templates.</li>
        <li>Visual access-card generation with attendee details and QR codes.</li>
        <li>Event-linked check-in booths for fast, controlled guest entry.</li>
        <li>Operational dashboards covering guests, cards, email delivery, and arrivals.</li>
      </ul>

      <dl class="details">
        <div><dt>Role</dt><dd>Product engineering</dd></div>
        <div><dt>Built for</dt><dd>enyspacelabs</dd></div>
        <div><dt>Year</dt><dd>2026</dd></div>
        <div><dt>Stack</dt><dd>React, TypeScript, Python, Flask, PostgreSQL, and Docker</dd></div>
        <div><dt>Integrations</dt><dd>REST APIs, HTML email templates, and QR codes</dd></div>
      </dl>
    </section>

    <nav class="project-nav" aria-label="Project navigation">
      <a href="/#work">All projects</a>
      <a href="/projects/mailstudio-standalone">Next: MailStudio →</a>
    </nav>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const current = gallery.querySelector<HTMLElement>('[data-current]');
    let active = 0;

    const show = (index: number) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => { slide.hidden = slideIndex !== active; });
      dots.forEach((dot, dotIndex) => {
        const selected = dotIndex === active;
        dot.classList.toggle('active', selected);
        if (selected) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (current) current.textContent = String(active + 1);
    };

    gallery.querySelector('[data-previous]')?.addEventListener('click', () => show(active - 1));
    gallery.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(active - 1);
      if (event.key === 'ArrowRight') show(active + 1);
    });
  });
</script>

<style>
  .project-page{width:min(100% - 40px,760px);margin:0 auto;padding:64px 0 100px}.project-header{margin-top:72px;padding-bottom:28px;border-bottom:1px solid var(--line)}.project-meta{margin:0 0 4px;color:var(--muted);font-size:13px}.project-header h1{margin:0;font:clamp(34px,5vw,46px)/1.15 var(--serif);letter-spacing:-.035em}.project-intro{max-width:650px;margin:24px 0 0;color:var(--muted);font-size:17px;line-height:1.7}.project-slideshow{margin-top:38px;padding:20px;border:1px solid var(--line);border-radius:10px;background:var(--soft);outline:none}.project-slideshow:focus-visible{box-shadow:0 0 0 2px var(--text)}.slide{margin:0}.slide[hidden]{display:none}.slide img{display:block;width:100%;height:auto;border-radius:5px;background:#fff}.slide figcaption{margin-top:12px;color:var(--muted);font-size:11px}.slideshow-controls{display:flex;align-items:center;justify-content:space-between;margin-top:18px}.slideshow-controls p{margin:0;color:var(--muted);font:11px Mono}.slideshow-controls button{padding:8px 0;border:0;background:transparent;color:var(--text);font:12px inherit;cursor:pointer}.slideshow-controls button:hover{text-decoration:underline}.slide-dots{display:flex;justify-content:center;gap:8px;margin-top:10px}.slide-dots button{width:7px;height:7px;padding:0;border:0;border-radius:50%;background:var(--line);cursor:pointer}.slide-dots button.active{background:var(--text)}.project-copy{width:min(100%,680px);margin:58px auto 0;font-size:17px;line-height:1.8}.project-copy h2{margin:48px 0 10px;font:26px/1.3 var(--serif);letter-spacing:-.02em}.project-copy h2:first-child{margin-top:0}.project-copy p{margin:0 0 20px;color:var(--muted)}.project-copy ul{margin:8px 0 0;padding-left:22px;color:var(--muted)}.project-copy li{margin-bottom:12px}.details{margin:50px 0 0;border-top:1px solid var(--line)}.details div{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:13px 0;border-bottom:1px solid var(--line)}.details dt{color:var(--muted);font:10px Mono;text-transform:uppercase;letter-spacing:.1em}.details dd{margin:0;font-size:13px}.project-nav{display:flex;justify-content:space-between;margin-top:68px;padding-top:20px;border-top:1px solid var(--line);font-size:13px}.project-nav a:hover{text-decoration:underline}
  @media(max-width:600px){.project-page{padding-top:38px}.project-header{margin-top:48px}.project-header h1{font-size:32px}.project-intro{font-size:15px}.project-slideshow{padding:10px}.slide figcaption{min-height:32px}.project-copy{margin-top:44px;font-size:16px}.details div{grid-template-columns:100px 1fr}}
</style>
